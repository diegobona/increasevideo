{
  "name": "increasevideoquality",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs dev",
    "lint": "eslint . --max-warnings=0",
    "build": "prisma generate && next build",
    "start": "node scripts/run-local.mjs start",
    "video:worker": "node --experimental-strip-types scripts/video-worker.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:db": "node --test tests/database.test.mjs",
    "test:rate-limit": "node scripts/test-job-rate-limit.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "test": "node --conditions=react-server --import tsx --test --test-concurrency=1 src/libs/video/*.test.ts tests/*.test.mjs tests/*.test.ts",
    "postinstall": "prisma generate",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-d1": "7.9.0",
    "@prisma/adapter-libsql": "7.9.0",
    "@prisma/client": "7.9.0",
    "@vinext/cloudflare": "1.4.0",
    "@web3-storage/multipart-parser": "1.0.0",
    "aws4fetch": "1.0.20",
    "jose": "^6.2.18",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "autoprefixer": "^10.4.21",
    "cf": "1.0.0-rc.2",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.6",
    "prisma": "7.9.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vinext": "^1.4.6",
    "vite": "8.3.0",
    "wrangler": "4.87.0"
  },
  "type": "module"
}

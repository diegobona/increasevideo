DATABASE_URL="file:./dev.db"

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
FAL_KEY=""
# Documented Topaz precision model (does not add a watermark on its own).
FAL_VIDEO_MODEL="topaz/upscale/video/precision"
# Optional legacy full fal workflow. Leave empty for Topaz + the bundled video worker.
FAL_FREE_VIDEO_MODEL=""
# pnpm dev/start starts the local FFmpeg worker and generates a temporary shared key.
# Cloudflare production: deploy worker.Dockerfile separately, use its HTTPS URL,
# and set the same strong VIDEO_WORKER_KEY in both services.
# Set R2_ACCOUNT_ID and R2_BUCKET_NAME on the worker too, to allow only this
# project's signed upload URLs. R2 access keys remain on the Next.js server.
VIDEO_WORKER_URL="http://127.0.0.1:8789"
VIDEO_WORKER_KEY=""
# Optional absolute paths when FFmpeg/FFprobe are not on PATH.
FFMPEG_PATH=""
FFPROBE_PATH=""
VIDEO_WORKER_FONT=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="video-input"

# Enable ONLY when requests arrive through Cloudflare, which overwrites this IP header.
TRUST_CLOUDFLARE_PROXY="false"

# Stripe hosted Checkout: USD charge currency, HKD settlement set in your Stripe account.
# No NEXT_PUBLIC_ key is needed for the server-created hosted checkout redirect.
APP_URL="http://localhost:3000"
# Google OAuth Web application. Authorized redirect URI must match APP_URL exactly:
# http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Subscribe this endpoint to checkout.session.completed,
# checkout.session.async_payment_succeeded and charge.refunded:
# https://your-domain/api/stripe/webhook
